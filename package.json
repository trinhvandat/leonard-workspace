{
  "name": "leonards-garden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "velite && next dev",
    "build": "velite build --strict && next build",
    "content": "velite build --strict",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "design-lint": "node scripts/design-lint.mjs",
    "guard": "node scripts/structural-guard.mjs",
    "verify": "npm run content && npm run design-lint && npm run lint && npm run typecheck && npm run test:coverage && npm run guard && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "github-slugger": "^2.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.6.0",
    "typescript": "^5",
    "velite": "^0.3.0",
    "vitest": "^3.2.4"
  }
}
